    },
    "error.trashUncertain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash did not return recovery information. Inspect Trash manually; do not retry automatically."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "කුණු කූඩයෙන් ප්‍රතිසාධන තොරතුරු ලැබුණේ නැත. අතින් පරීක්ෂා කරන්න; ස්වයංක්‍රීයව නැවත නොකරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "குப்பை மீட்புத் தகவலை வழங்கவில்லை. கைமுறையாகச் சரிபார்க்கவும்; தானாக மீண்டும் முயல வேண்டாம்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ट्रैश ने पुनर्प्राप्ति जानकारी नहीं दी। ट्रैश जाँचें; अपने आप पुनः प्रयास न करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم تُرجع السلة معلومات الاستعادة. افحصها يدوياً ولا تكرر تلقائياً."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Informations de récupération absentes. Inspectez la Corbeille ; ne réessayez pas automatiquement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "废纸篓未返回恢复信息。请手动检查，切勿自动重试。"
          }
        }
      }
    },
    "error.recoveryUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
