    "trendNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Historical totals are scanned logical bytes. Different roots and inaccessible items can make scans incomparable."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "එකතු පරිලෝකනය කළ තාර්කික බයිට් වේ. වෙනස් ෆෝල්ඩර සහ ප්‍රවේශ සීමා නිසා පරිලෝකන සැසඳිය නොහැකි විය හැක."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மொத்தங்கள் வருடப்பட்ட தருக்க பைட்டுகள். வெவ்வேறு இடங்கள் மற்றும் அணுகல் வரம்புகளால் வருடல்களை ஒப்பிட முடியாமல் போகலாம்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कुल स्कैन किए गए तार्किक बाइट हैं। अलग फ़ोल्डर और पहुँच सीमाओं के कारण स्कैन अतुलनीय हो सकते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الإجماليات هي بايتات منطقية مفحوصة. قد تمنع اختلافات المواقع والأذونات مقارنة الفحوص."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les totaux sont les octets logiques analysés. Des dossiers ou autorisations différents peuvent empêcher la comparaison."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "总计为扫描的逻辑字节数。不同的根目录和访问限制可能使扫描结果无法比较。"
          }
        }
      }
    },
