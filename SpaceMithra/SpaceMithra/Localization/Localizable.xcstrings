            "value": "محظور"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloqué"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已阻止"
          }
        }
      }
    },
    "review.guidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This review checks the exact files you selected. Remove blocked items from the queue and review again. Nothing moves until you confirm. Files will be checked again before Trash."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මෙම සමාලෝචනය තෝරාගත් නිශ්චිත ගොනු පරීක්ෂා කරයි. අවහිර අයිතම පෝලිමෙන් ඉවත් කර නැවත සමාලෝචනය කරන්න. තහවුරු කරන තුරු කිසිවක් ගෙන යන්නේ නැත. කුණු කූඩයට ගෙන යාමට පෙර නැවත පරීක්ෂා කරයි."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் தேர்ந்தெடுத்த குறிப்பிட்ட கோப்புகள் சரிபார்க்கப்படும். தடுக்கப்பட்டவற்றை வரிசையிலிருந்து நீக்கி மீண்டும் சரிபார்க்கவும். உறுதிப்படுத்தும் வரை எதுவும் நகராது. குப்பைக்கு நகர்த்தும் முன் மீண்டும் சரிபார்க்கப்படும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह समीक्षा चुनी हुई सटीक फ़ाइलें जाँचती है। अवरुद्ध आइटम कतार से हटाकर फिर समीक्षा करें। पुष्टि तक कुछ नहीं हटेगा। ट्रैश में भेजने से पहले फिर जाँच होगी।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتحقق المراجعة من الملفات المحددة بعينها. أزل العناصر المحظورة من القائمة وراجع مجدداً. لن يُنقل شيء قبل التأكيد. سيُعاد التحقق قبل النقل إلى السلة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette vérification porte sur les fichiers précis sélectionnés. Retirez les éléments bloqués de la file et vérifiez à nouveau. Rien ne sera déplacé avant confirmation. Une nouvelle vérification précède la Corbeille."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "本次检查针对您选择的确切文件。请从队列中移除受阻项目，然后重新检查。确认前不会移动任何内容。移到废纸篓前将再次检查文件。"
          }
        }
      }
    },
