    "scan.interrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This scan did not finish. The results below are partial; scan again to update them."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මෙම පරිලෝකනය අවසන් නොවීය. පහත ප්‍රතිඵල අසම්පූර්ණයි; යාවත්කාලීන කිරීමට නැවත පරිලෝකනය කරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த வருடல் முடிவடையவில்லை. கீழுள்ள முடிவுகள் பகுதியானவை; மீண்டும் வருடவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह स्कैन पूरा नहीं हुआ। नीचे आंशिक परिणाम हैं; अद्यतन करने के लिए फिर स्कैन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يكتمل الفحص. النتائج أدناه جزئية؛ أعد الفحص لتحديثها."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette analyse n’a pas abouti. Les résultats sont partiels ; relancez-la pour les actualiser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此次扫描未完成。下方结果不完整；请重新扫描以更新。"
          }
        }
      }
    },
    "scan.allowFolder": {
      "extractionState": "manual",
      "localizations": {
