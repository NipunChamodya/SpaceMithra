    "error.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another operation is running. Wait for it to finish."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "වෙනත් ක්‍රියාවක් සිදුවෙයි. එය අවසන් වන තුරු රැඳී සිටින්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மற்றொரு செயல் நடைபெறுகிறது. அது முடியும் வரை காத்திருக்கவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दूसरी कार्रवाई जारी है। उसके पूरा होने तक प्रतीक्षा करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عملية أخرى قيد التنفيذ. انتظر اكتمالها."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une opération est en cours. Attendez sa fin."
          }
        },
        "zh-Hans": {
