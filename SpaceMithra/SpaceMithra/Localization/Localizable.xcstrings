    "partialNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the current page, up to 12 largest entries. Partial scans and inaccessible files leave totals incomplete. Allocated bytes are estimates; APFS clones may share blocks."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "වත්මන් පිටුවේ විශාලතම අයිතම 12ක් දක්වයි. අසම්පූර්ණ පරිලෝකන සහ ප්‍රවේශ නොහැකි ගොනු නිසා එකතුව අසම්පූර්ණ විය හැක. APFS ගොනු තැටි කොටස් බෙදාගත හැක."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "தற்போதைய பக்கத்தில் மிகப்பெரிய 12 உருப்படிகள் காட்டப்படும். முழுமையற்ற வருடலும் அணுக முடியாத கோப்புகளும் மொத்தத்தைப் பாதிக்கும். APFS நகல்கள் தொகுதிகளைப் பகிரலாம்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वर्तमान पृष्ठ के अधिकतम 12 सबसे बड़े आइटम दिखते हैं। अधूरे स्कैन और अप्राप्य फ़ाइलों से कुल अधूरा हो सकता है। APFS क्लोन ब्लॉक साझा कर सकते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعرض الصفحة الحالية حتى 12 من أكبر العناصر. الفحص الجزئي والملفات غير المتاحة يجعلان الإجماليات ناقصة. قد تتشارك نسخ APFS كتل التخزين."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affiche jusqu’à 12 grands éléments de la page actuelle. Une analyse partielle ou des fichiers inaccessibles rendent les totaux incomplets. Les clones APFS peuvent partager des blocs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "显示当前页面中最多12个最大项目。部分扫描和无法访问的文件会导致总计不完整。APFS 克隆可能共享存储块。"
          }
        }
      }
    },
    "trends": {
      "extractionState": "manual",
      "localizations": {
