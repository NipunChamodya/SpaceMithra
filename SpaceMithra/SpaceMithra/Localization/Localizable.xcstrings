    "scan.otherVolume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This belongs to another storage device. Scan it separately to avoid counting storage twice."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මෙය වෙනත් ගබඩා උපාංගයකි. දෙවරක් ගණනය වළක්වා වෙනම පරිලෝකනය කරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இது வேறொரு சேமிப்பகச் சாதனம். இருமுறை கணக்கிடாமல் தனியாக வருடவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह दूसरे स्टोरेज उपकरण पर है। दोहरी गिनती से बचने के लिए अलग स्कैन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذا جهاز تخزين آخر. افحصه منفصلاً لتجنب العد مرتين."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autre périphérique de stockage. Analysez-le séparément pour éviter le double comptage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此项目属于另一存储设备。请单独扫描以避免重复统计。"
          }
        }
      }
