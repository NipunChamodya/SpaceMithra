    "welcomeSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand your storage. Choose what stays."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ඔබේ ගබඩාව තේරුම් ගන්න. තබාගන්නා දේ තෝරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "சேமிப்பகத்தைப் புரிந்துகொள்ளுங்கள். எதை வைத்திருக்க வேண்டும் என்பதைத் தேர்ந்தெடுங்கள்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपना स्टोरेज समझें। तय करें कि क्या रखना है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افهم مساحة التخزين واختر ما تريد الاحتفاظ به."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprenez votre stockage. Choisissez ce qui reste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "了解存储空间，选择保留的内容。"
          }
        }
      }
    },
    "privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline and private. No accounts, uploads, ads, or telemetry."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "නොබැඳි සහ පෞද්ගලිකයි. ගිණුම්, උඩුගත කිරීම්, දැන්වීම් හෝ භාවිත දත්ත රැස් කිරීම නැත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இணையமின்றி தனியுரிமையுடன். கணக்குகள், பதிவேற்றங்கள், விளம்பரங்கள் அல்லது பயன்பாட்டுத் தரவு சேகரிப்பு இல்லை."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऑफ़लाइन और निजी। कोई खाता, अपलोड, विज्ञापन या उपयोग डेटा संग्रह नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "خاص ويعمل دون اتصال. بلا حسابات أو رفع ملفات أو إعلانات أو جمع بيانات استخدام."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hors ligne et privé. Sans compte, envoi de fichiers, publicité ni télémétrie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "离线且保护隐私。无需账户、上传文件、广告或遥测。"
          }
        }
      }
    },
    "scanGuidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder to scan. Scanning only reads metadata. macOS may ask permission for the selected location. If access is denied, choose a smaller accessible folder. Full Disk Access is optional and is never requested at startup."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "පරිලෝකනයට ෆෝල්ඩරයක් තෝරන්න. මෙය පාරදත්ත පමණක් කියවයි. macOS අවසර ඉල්ලා සිටිය හැක. ප්‍රවේශය ප්‍රතික්ෂේප වුවහොත් වෙනත් ෆෝල්ඩරයක් තෝරන්න. සම්පූර්ණ තැටි ප්‍රවේශය ආරම්භයේදී ඉල්ලන්නේ නැත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "வருட ஒரு கோப்புறையைத் தேர்ந்தெடுக்கவும். வருடல் மெட்டாடேட்டாவை மட்டுமே படிக்கும். macOS அனுமதி கேட்கலாம். அணுகல் மறுக்கப்பட்டால் மற்றொரு கோப்புறையைத் தேர்ந்தெடுக்கவும். தொடக்கத்தில் முழு வட்டு அணுகல் கேட்கப்படாது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्कैन करने के लिए फ़ोल्डर चुनें। स्कैन केवल मेटाडेटा पढ़ता है। macOS अनुमति माँग सकता है। अनुमति न मिलने पर दूसरा फ़ोल्डर चुनें। शुरुआत में पूर्ण डिस्क पहुँच नहीं माँगी जाती।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر مجلداً لفحصه. يقرأ الفحص البيانات الوصفية فقط. قد يطلب macOS إذناً. إذا رُفض الوصول فاختر مجلداً آخر. لا يُطلب الوصول الكامل للقرص عند بدء التشغيل."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez un dossier. L’analyse lit seulement les métadonnées. macOS peut demander une autorisation. En cas de refus, choisissez un autre dossier. L’accès complet au disque n’est pas demandé au démarrage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择要扫描的文件夹。扫描只读取元数据。macOS 可能会请求权限。如果访问被拒绝，请选择其他可访问的文件夹。启动时不会请求完全磁盘访问权限。"
          }
        }
      }
    },
