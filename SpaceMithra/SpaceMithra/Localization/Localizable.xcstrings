    "scan.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a partial view of accessible files, not a full accounting of your disk. macOS protects some locations; other accounts, snapshots and shared blocks may not be visible."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මෙය ප්‍රවේශ විය හැකි ගොනුවල අර්ධ දසුනකි; සම්පූර්ණ තැටි ගණනයක් නොවේ. සමහර ස්ථාන macOS ආරක්ෂා කරයි."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இது அணுகக்கூடிய கோப்புகளின் பகுதி காட்சி மட்டுமே. முழு வட்டுக் கணக்கல்ல. சில இடங்களை macOS பாதுகாக்கிறது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह सुलभ फ़ाइलों का आंशिक दृश्य है, पूरी डिस्क का हिसाब नहीं। macOS कुछ स्थान सुरक्षित रखता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذه نظرة جزئية للملفات المتاحة وليست حساباً كاملاً للقرص. يحمي macOS بعض المواقع."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vue partielle des fichiers accessibles, et non comptabilité complète du disque. macOS protège certains emplacements."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这只是可访问文件的部分视图，并非完整的磁盘统计。macOS 会保护部分位置。"
          }
        }
      }
    },
