        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قد تؤثر الإزالة على مواقع أو تطبيقات أو أجهزة متزامنة أخرى. التنظيف محظور."
          }
        },
        "fr": {
          "stringUnit": {
