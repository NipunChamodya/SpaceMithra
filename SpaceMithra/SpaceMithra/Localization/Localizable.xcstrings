    "disk.attribution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System data, protected files, snapshots and shared APFS blocks cannot be reconciled exactly through this API. Scanned logical sizes are not physical disk usage."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මෙම API මඟින් පද්ධති දත්ත, ආරක්ෂිත ගොනු, ඡායාපිටපත් සහ හවුල් APFS කොටස් නිශ්චිතව වෙන් කළ නොහැක. තාර්කික ගොනු ප්‍රමාණ භෞතික තැටි භාවිතය නොවේ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த API மூலம் அமைப்புத் தரவு, பாதுகாக்கப்பட்ட கோப்புகள், நொடிப்படங்கள் மற்றும் பகிரப்பட்ட APFS தொகுதிகளைத் துல்லியமாகப் பிரிக்க முடியாது. தருக்க அளவு வட்டு பயன்பாடு அல்ல."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस API से सिस्टम डेटा, सुरक्षित फ़ाइलों, स्नैपशॉट और साझा APFS ब्लॉक का सटीक मिलान संभव नहीं। तार्किक आकार भौतिक डिस्क उपयोग नहीं है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن مطابقة بيانات النظام والملفات المحمية واللقطات وكتل APFS المشتركة بدقة عبر هذه الواجهة. الأحجام المنطقية ليست استخداماً فعلياً للقرص."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette API ne permet pas d’attribuer exactement données système, fichiers protégés, instantanés et blocs APFS partagés. La taille logique n’est pas l’usage physique du disque."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 API 无法精确区分系统数据、受保护文件、快照和共享 APFS 数据块。逻辑文件大小并不等于物理磁盘占用。"
          }
        }
      }
    },
