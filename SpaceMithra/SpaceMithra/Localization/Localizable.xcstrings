            "value": "දේශීය දත්ත සමුදාය නොමැත. පිරිසිදු කිරීම නවත්වා ඇත. ප්‍රතිසාධන දත්ත රැකගන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உள்ளூர் தரவுத்தளம் கிடைக்கவில்லை. சுத்தப்படுத்தல் நிறுத்தப்பட்டது. மீட்புத் தரவைப் பாதுகாக்கவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्थानीय डेटाबेस अनुपलब्ध है। सफ़ाई रोकी गई है। पुनर्प्राप्ति डेटा सुरक्षित रखें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قاعدة البيانات المحلية غير متاحة. توقف التنظيف. احتفظ ببيانات الاستعادة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Base locale indisponible. Nettoyage arrêté. Préservez les données de récupération."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
