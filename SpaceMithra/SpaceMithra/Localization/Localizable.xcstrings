    "suggestion.explain.installers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may need these to reinstall software. Review each file before deciding."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මෘදුකාංග නැවත ස්ථාපනයට මේවා අවශ්‍ය විය හැක. සෑම ගොනුවක්ම සමාලෝචනය කරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மென்பொருளை மீண்டும் நிறுவ இவை தேவைப்படலாம். ஒவ்வொன்றையும் சரிபார்க்கவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सॉफ़्टवेयर फिर इंस्टॉल करने में इनकी ज़रूरत हो सकती है। हर फ़ाइल देखें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قد تحتاجها لإعادة تثبيت البرامج. راجع كل ملف."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ils peuvent servir à réinstaller un logiciel. Examinez chaque fichier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新安装软件时可能仍需要这些文件。请逐个检查。"
          }
        }
      }
    },
    "suggestion.explain.videos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large does not mean unnecessary. Keep recordings and projects you still need."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "විශාල වීම අනවශ්‍ය බව නොවේ. අවශ්‍ය පටිගත කිරීම් සහ ව්‍යාපෘති තබාගන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "பெரியதாக இருப்பதால் தேவையற்றது அல்ல. தேவையான பதிவுகளையும் திட்டங்களையும் வைத்திருக்கவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बड़ी फ़ाइल अनावश्यक नहीं होती। ज़रूरी रिकॉर्डिंग और परियोजनाएँ रखें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الحجم الكبير لا يعني أنه غير ضروري. احتفظ بالتسجيلات والمشاريع المطلوبة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volumineux ne signifie pas inutile. Gardez vos enregistrements et projets nécessaires."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "体积大不代表不需要。请保留仍需使用的录制内容和项目。"
          }
        }
      }
    },
    "suggestion.explain.caches": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the owning app and review the consequences. Nothing is selected automatically."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "අදාළ යෙදුම වසා ප්‍රතිවිපාක සමාලෝචනය කරන්න. කිසිවක් ස්වයංක්‍රීයව තෝරන්නේ නැත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "தொடர்புடைய செயலியை மூடி விளைவுகளைச் சரிபார்க்கவும். தானியங்கித் தேர்வு இல்லை."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "संबंधित ऐप बंद करके परिणाम देखें। कोई चयन अपने आप नहीं होता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أغلق التطبيق المعني وراجع النتائج. لا تحديد تلقائي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fermez l’app concernée et examinez les conséquences. Aucune présélection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请关闭所属应用并检查删除后果。不会自动选择任何内容。"
          }
        }
      }
    }
