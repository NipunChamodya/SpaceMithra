        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हटाने से अन्य स्थान, ऐप्स या सिंक किए गए डिवाइस प्रभावित हो सकते हैं। सफ़ाई अवरुद्ध है।"
          }
