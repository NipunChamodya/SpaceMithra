    "message.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleanup was cancelled. No move was attempted for this item. Review again before retrying."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "පිරිසිදු කිරීම අවලංගු කළා. මෙම අයිතමය ගෙන යාමට උත්සාහ කළේ නැත. නැවත උත්සාහයට පෙර සමාලෝචනය කරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "சுத்தப்படுத்தல் ரத்துசெய்யப்பட்டது. இந்த உருப்படியை நகர்த்த முயற்சிக்கவில்லை. மீண்டும் முயலும் முன் சரிபார்க்கவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सफ़ाई रद्द कर दी गई। इस आइटम को भेजने का प्रयास नहीं हुआ। दोबारा प्रयास से पहले समीक्षा करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أُلغي التنظيف. لم تحدث محاولة لنقل هذا العنصر. راجعه قبل إعادة المحاولة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nettoyage annulé. Aucun déplacement tenté pour cet élément. Vérifiez à nouveau avant de réessayer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "清理已取消。未尝试移动此项目。重试前请重新检查。"
          }
        }
      }
    },
