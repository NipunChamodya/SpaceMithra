    "apps.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with an app overview. Technical files stay hidden until you ask to see them."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "යෙදුම් දළ විශ්ලේෂණයෙන් අරඹන්න. ඔබ ඉල්ලන තුරු තාක්ෂණික ගොනු සැඟවී ඇත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "செயலியின் மேலோட்டத்திலிருந்து தொடங்கவும். கேட்கும் வரை தொழில்நுட்பக் கோப்புகள் மறைந்திருக்கும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऐप के अवलोकन से शुरू करें। तकनीकी फ़ाइलें आपके कहने तक छिपी रहती हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابدأ بنظرة عامة على التطبيق. تبقى الملفات التقنية مخفية حتى تطلبها."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Commencez par une vue d’ensemble. Les fichiers techniques restent masqués jusqu’à votre demande."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "先查看应用概览。只有您选择查看时，才会显示技术文件。"
          }
        }
      }
    },
