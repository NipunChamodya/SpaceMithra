    "apps.attribution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only exact bundle-identifier locations are attributed. Unknown related data is left unassigned. Sizes are scan estimates; partial scans may miss files."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "නිශ්චිත bundle හැඳුනුම් ස්ථාන පමණක් සම්බන්ධ කරයි. නොදන්නා දත්ත වෙන් කර නැත. ප්‍රමාණ පරිලෝකන ඇස්තමේන්තු වේ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "சரியான bundle அடையாள இடங்கள் மட்டுமே தொடர்புபடுத்தப்படும். தெரியாத தரவு ஒதுக்கப்படாது. அளவுகள் வருடல் மதிப்பீடுகள்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "केवल सटीक बंडल पहचान वाले स्थान जोड़े जाते हैं। अज्ञात डेटा नहीं जोड़ा जाता। आकार स्कैन अनुमान हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُربط المواقع ذات معرّف الحزمة المطابق فقط. تبقى البيانات غير المعروفة دون إسناد. الأحجام تقديرات فحص."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seuls les emplacements au même identifiant de bundle sont attribués. Les données inconnues restent non attribuées. Tailles estimées par l’analyse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅关联与 bundle 标识完全匹配的位置。未知关联数据保持未归属。大小是扫描估计值，部分扫描可能遗漏文件。"
          }
        }
      }
    },
