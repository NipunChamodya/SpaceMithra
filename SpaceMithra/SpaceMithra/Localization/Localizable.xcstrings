    "error.invalidLocation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This location is unavailable. Choose a folder inside the storage area you scanned."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මෙම ස්ථානය ලබාගත නොහැක. පරිලෝකනය කළ ගබඩාව තුළ ෆෝල්ඩරයක් තෝරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த இடம் கிடைக்கவில்லை. வருடிய சேமிப்பகத்தில் உள்ள கோப்புறையைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह स्थान उपलब्ध नहीं है। स्कैन किए गए क्षेत्र में कोई फ़ोल्डर चुनें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذا الموقع غير متاح. اختر مجلداً داخل مساحة التخزين المفحوصة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Emplacement indisponible. Choisissez un dossier dans la zone analysée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此位置不可用。请选择已扫描存储区域内的文件夹。"
          }
        }
      }
    },
    "error.capacity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac could not report its storage capacity right now. Try refreshing later."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ඔබේ Mac හි ගබඩා ධාරිතාව දැන් ලබාගත නොහැක. පසුව නැවුම් කරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் Mac இன் சேமிப்பக அளவை இப்போது பெற முடியவில்லை. பிறகு புதுப்பிக்கவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अभी Mac की स्टोरेज क्षमता नहीं मिल सकी। बाद में ताज़ा करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذر الحصول على سعة تخزين Mac الآن. حاول التحديث لاحقاً."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Capacité du Mac indisponible pour le moment. Réessayez plus tard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暂时无法获取 Mac 的存储容量。请稍后刷新。"
          }
        }
      }
    },
    "error.permissionFriendly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SpaceMithra can’t look inside this folder yet. Your Mac protects some files for privacy."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SpaceMithra හට මෙම ෆෝල්ඩරය තුළ බැලීමට තවම නොහැක. පෞද්ගලිකත්වය සඳහා Mac සමහර ගොනු ආරක්ෂා කරයි."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SpaceMithra இப்போது இந்தக் கோப்புறையைப் பார்க்க முடியாது. தனியுரிமைக்காக உங்கள் Mac சில கோப்புகளைப் பாதுகாக்கிறது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SpaceMithra अभी इस फ़ोल्डर के अंदर नहीं देख सकता। आपका Mac गोपनीयता के लिए कुछ फ़ाइलें सुरक्षित रखता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يستطيع SpaceMithra الاطلاع على هذا المجلد بعد. يحمي Mac بعض الملفات لخصوصيتك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SpaceMithra ne peut pas encore consulter ce dossier. Votre Mac protège certains fichiers pour votre confidentialité."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SpaceMithra 暂时无法查看此文件夹。Mac 会保护部分文件以保障隐私。"
          }
        }
      }
    },
