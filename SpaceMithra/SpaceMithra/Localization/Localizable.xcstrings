    "error.restoreChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Trash item or original folder changed. Restore was refused."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "කුණු කූඩ අයිතමය හෝ මුල් ෆෝල්ඩරය වෙනස් වී ඇත. ප්‍රතිසාධනය ප්‍රතික්ෂේප කළා."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "குப்பை உருப்படி அல்லது அசல் கோப்புறை மாறிவிட்டது. மீட்பு மறுக்கப்பட்டது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ट्रैश आइटम या मूल फ़ोल्डर बदल गया है। पुनर्स्थापना रोकी गई।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تغير عنصر السلة أو المجلد الأصلي. رُفضت الاستعادة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Élément de Corbeille ou dossier d’origine modifié. Restauration refusée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "废纸篓中的项目或原始文件夹已更改。已拒绝恢复。"
          }
        }
      }
    },
    "error.conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original path exists or cannot be checked. No overwrite was attempted."
