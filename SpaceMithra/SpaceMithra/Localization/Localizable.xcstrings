          "stringUnit": {
            "state": "needs_review",
            "value": "මෙම අයිතමයේ අරමුණ තහවුරු කරන පිරිසිදු කිරීමේ රීතියක් නැත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த உருப்படியின் நோக்கத்தை உறுதிப்படுத்தும் சுத்தப்படுத்தல் விதி இல்லை."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस आइटम का उद्देश्य स्थापित करने वाला कोई सफ़ाई नियम नहीं है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد قاعدة تنظيف تثبت الغرض من هذا العنصر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune règle de nettoyage ne permet d’établir l’usage de cet élément."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有明确的清理规则可以确认此项目的用途。"
          }
        }
      }
    },
    "history.pending": {
