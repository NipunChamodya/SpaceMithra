      }
    },
    "disk.estimateNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remainder estimate subtracts known scanned allocated bytes from reported used storage on this startup disk. Shared blocks and unavailable metadata prevent exact attribution. It is not guaranteed reclaimable space."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ඉතිරි ඇස්තමේන්තුව වාර්තා කළ භාවිතයෙන් දන්නා වෙන් කළ බයිට් අඩු කරයි. හවුල් කොටස් සහ නොමැති පාරදත්ත නිසා නිශ්චිත වෙන් කිරීමක් කළ නොහැක. මෙය නිදහස් කළ හැකි බවට සහතික ඉඩක් නොවේ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மீதமுள்ள மதிப்பீடு அறியப்பட்ட ஒதுக்கப்பட்ட பைட்டுகளை வட்டு பயன்பாட்டிலிருந்து கழிக்கிறது. பகிரப்பட்ட தொகுதிகள் மற்றும் கிடைக்காத மெட்டாடேட்டா காரணமாக துல்லியம் இல்லை. மீட்டெடுக்கக்கூடிய இடத்திற்கான உத்தரவாதமல்ல."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "शेष अनुमान उपयोग किए स्टोरेज से स्कैन में ज्ञात आवंटित बाइट घटाता है। साझा ब्लॉक और अनुपलब्ध मेटाडेटा सटीक हिसाब रोकते हैं। यह खाली हो सकने वाले स्थान की गारंटी नहीं है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يطرح التقدير البايتات المخصصة المعروفة من الاستخدام المبلغ عنه. تمنع الكتل المشتركة والبيانات الوصفية الغائبة الإسناد الدقيق. ليس مساحة مضمونة الاسترداد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’estimation soustrait les octets alloués connus de l’espace utilisé. Blocs partagés et métadonnées absentes empêchent une attribution exacte. Ce n’est pas un espace récupérable garanti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此估计值从报告的已用空间中减去扫描中已知的分配字节数。共享数据块和缺失元数据使精确归属无法实现。这并非保证可释放的空间。"
          }
        }
      }
    },
