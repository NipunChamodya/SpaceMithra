      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original path exists or cannot be checked. No overwrite was attempted."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මුල් මාර්ගය පවතී හෝ පරීක්ෂා කළ නොහැක. උඩින් ලිවීමට උත්සාහ කළේ නැත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அசல் பாதை உள்ளது அல்லது சரிபார்க்க முடியவில்லை. மேலெழுத முயற்சிக்கவில்லை."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मूल पथ मौजूद है या जाँचा नहीं जा सकता। उस पर लिखने का प्रयास नहीं हुआ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المسار الأصلي موجود أو تعذر التحقق منه. لم تحدث محاولة استبدال."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chemin d’origine existant ou invérifiable. Aucun écrasement tenté."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "原始路径已存在或无法检查。未尝试覆盖。"
          }
        }
      }
    },
    "error.restoreUncertain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore could not be verified. Inspect the original location before trying again."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ප්‍රතිසාධනය තහවුරු කළ නොහැක. නැවත උත්සාහයට පෙර මුල් ස්ථානය පරීක්ෂා කරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மீட்பை உறுதிப்படுத்த முடியவில்லை. மீண்டும் முயலும் முன் அசல் இடத்தைச் சரிபார்க்கவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पुनर्स्थापना सत्यापित नहीं हो सकी। फिर कोशिश से पहले मूल स्थान जाँचें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذر التحقق من الاستعادة. افحص الموقع الأصلي قبل المحاولة مجدداً."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restauration non vérifiée. Inspectez l’emplacement d’origine avant de réessayer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法验证恢复结果。重试前请检查原始位置。"
          }
        }
      }
    },
    "error.duplicateLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate detection is limited to 20,000 candidates. Scan a smaller folder."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "අනුපිටපත් සෙවීම ගොනු 20,000කට සීමා වේ. කුඩා ෆෝල්ඩරයක් පරිලෝකනය කරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நகல் கண்டறிதல் 20,000 கோப்புகளுக்கு வரையறுக்கப்பட்டுள்ளது. சிறிய கோப்புறையை வருடவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "डुप्लिकेट खोज 20,000 फ़ाइलों तक सीमित है। छोटा फ़ोल्डर स्कैन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كشف التكرار محدود بعشرين ألف ملف. افحص مجلداً أصغر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Détection limitée à 20 000 candidats. Analysez un dossier plus petit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重复检测最多支持20,000个候选文件。请扫描较小的文件夹。"
          }
        }
      }
    },
