    "dev.sources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source code and active environments are not disposable temporary files. Nothing is selected automatically."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මූලාශ්‍ර කේත සහ සක්‍රිය පරිසර තාවකාලික ගොනු නොවේ. කිසිවක් ස්වයංක්‍රීයව තෝරන්නේ නැත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மூலக் குறியீடும் செயலில் உள்ள சூழல்களும் அகற்றக்கூடிய தற்காலிகக் கோப்புகள் அல்ல. தானாக எதுவும் தேர்ந்தெடுக்கப்படாது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्रोत कोड और सक्रिय वातावरण हटाने योग्य अस्थायी फ़ाइलें नहीं हैं। कोई चयन अपने आप नहीं होता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الشيفرة المصدرية والبيئات النشطة ليست ملفات مؤقتة للاستغناء عنها. لا تحديد تلقائي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le code source et les environnements actifs ne sont pas des fichiers temporaires jetables. Rien n’est présélectionné."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "源代码和活动环境不是可随意清理的临时文件。不会自动选择任何内容。"
          }
        }
      }
    },
    "dev.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recognized accessible tool storage found yet. Scan a project folder to discover its dependencies and environments."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "තවම හඳුනාගත් ප්‍රවේශ කළ හැකි මෙවලම් ගබඩාවක් නැත. ව්‍යාපෘති ෆෝල්ඩරයක් පරිලෝකනය කරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அணுகக்கூடிய கருவிச் சேமிப்பகம் இன்னும் கண்டறியப்படவில்லை. திட்டக் கோப்புறையை வருடவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अभी कोई पहचाना गया सुलभ टूल स्टोरेज नहीं मिला। परियोजना फ़ोल्डर स्कैन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يُعثر بعد على تخزين أدوات معروف ومتاح. افحص مجلد مشروع."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun stockage d’outil accessible reconnu. Analysez un dossier de projet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚未找到可访问的已识别工具存储。请扫描项目文件夹。"
