        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "පරිලෝකනය සිදුවෙමින් පවතී. ප්‍රතිඵල අසම්පූර්ණයි. පිරිසිදු කිරීම අක්‍රියයි."
