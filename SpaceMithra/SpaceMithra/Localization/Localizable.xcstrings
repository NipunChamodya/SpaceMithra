    "welcome.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what takes up space and decide what to keep. We’ll guide you through the details."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ඉඩ ගන්නා දේ බලන්න, තබාගන්නා දේ තීරණය කරන්න. විස්තර තේරුම් ගැනීමට අපි උදව් කරන්නෙමු."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "எது இடத்தைப் பயன்படுத்துகிறது என்று பார்த்து எதை வைத்திருக்க வேண்டும் என்று தீர்மானிக்கவும். விவரங்களை அறிய வழிகாட்டுவோம்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "देखें कि जगह कहाँ जा रही है और क्या रखना है तय करें। हम विवरण समझने में मदद करेंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اعرف ما يشغل المساحة واختر ما تحتفظ به. سنرشدك لفهم التفاصيل."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Découvrez ce qui prend de la place et choisissez ce que vous gardez. Nous vous guidons dans les détails."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "查看哪些内容占用了空间，再决定保留什么。我们会帮助您了解详情。"
          }
        }
      }
    },
    "welcome.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning never deletes files."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "පරිලෝකනයෙන් කිසිදු ගොනුවක් මකන්නේ නැත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "வருடல் எந்தக் கோப்பையும் நீக்காது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्कैन कभी फ़ाइलें नहीं मिटाता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الفحص لا يحذف الملفات أبداً."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’analyse ne supprime aucun fichier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "扫描绝不会删除文件。"
          }
        }
      }
    },
    "welcome.permissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac may ask before allowing access to private folders. You can decline and still review the locations that are accessible."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "පෞද්ගලික ෆෝල්ඩරවලට ප්‍රවේශයට පෙර Mac අවසර ඉල්ලිය හැක. ඔබට ප්‍රතික්ෂේප කර ප්‍රවේශ කළ හැකි ස්ථාන බලන්න පුළුවන්."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "தனிப்பட்ட கோப்புறைகளுக்கு Mac அனுமதி கேட்கலாம். மறுத்தாலும் அணுகக்கூடிய இடங்களைப் பார்க்கலாம்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "निजी फ़ोल्डरों की पहुँच के लिए Mac अनुमति माँग सकता है। मना करने पर भी उपलब्ध स्थान देख सकते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قد يطلب Mac إذناً للمجلدات الخاصة. يمكنك الرفض ومراجعة المواقع المتاحة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre Mac peut demander l’accès aux dossiers privés. Vous pouvez refuser et examiner les emplacements accessibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac 可能会请求访问私人文件夹的权限。您可以拒绝，仍可检查其他可访问的位置。"
          }
        }
      }
    },
    "scan.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting to know your storage"
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ඔබේ ගබඩාව හඳුනා ගනිමින්"
          }
