    "error.operationFriendly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item could not be inspected right now. It may have changed or its storage may be unavailable. Check the details or try again."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මෙම අයිතමය දැන් පරීක්ෂා කළ නොහැක. එය වෙනස් වී හෝ ගබඩාව නොමැති විය හැක. විස්තර බලන්න හෝ නැවත උත්සාහ කරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த உருப்படியை இப்போது சரிபார்க்க முடியவில்லை. அது மாறியிருக்கலாம் அல்லது சேமிப்பகம் கிடைக்காமல் இருக்கலாம். விவரங்களைப் பார்க்கவும் அல்லது மீண்டும் முயலவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस आइटम को अभी जाँचा नहीं जा सका। यह बदल गया होगा या स्टोरेज उपलब्ध नहीं होगा। विवरण देखें या फिर प्रयास करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذر فحص هذا العنصر الآن. قد يكون تغير أو تخزينه غير متاح. راجع التفاصيل أو حاول مجدداً."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible d’examiner cet élément maintenant. Il a peut-être changé ou son stockage est indisponible. Consultez les détails ou réessayez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暂时无法检查此项目。它可能已更改，或其存储位置不可用。请查看详情或重试。"
          }
        }
      }
    },
