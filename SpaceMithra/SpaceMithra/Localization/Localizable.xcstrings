        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ඉවත් කිරීම වෙනත් ස්ථාන, යෙදුම් හෝ සමමුහුර්ත උපාංගවලට බලපෑ හැක. පිරිසිදු කිරීම අවහිරයි."
