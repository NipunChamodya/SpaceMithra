    "recoveryCheck.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Availability is a read-only snapshot, checked again before restoring. Recovery is unavailable after Trash is emptied."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ලබාගත හැකි බව කියවීමට පමණක් වූ තත්ත්ව පරීක්ෂාවකි. ප්‍රතිසාධනයට පෙර නැවත පරීක්ෂා කරයි. කුණු කූඩය හිස් කළ පසු ප්‍රතිසාධනය කළ නොහැක."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கிடைக்கும் நிலை படிப்பதற்கான சரிபார்ப்பு மட்டுமே. மீட்புக்கு முன் மீண்டும் சரிபார்க்கப்படும். குப்பை காலியான பின் மீட்க முடியாது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "उपलब्धता केवल पढ़ने वाली स्थिति-जाँच है। पुनर्स्थापना से पहले फिर जाँच होगी। ट्रैश खाली होने के बाद पुनर्प्राप्ति नहीं होगी।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التوفر فحص للقراءة فقط ويُعاد التحقق قبل الاستعادة. لا تتاح الاستعادة بعد إفراغ السلة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La disponibilité est un instantané en lecture seule, vérifié à nouveau avant restauration. Aucune récupération après vidage de la Corbeille."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可用性仅为只读状态快照，恢复前会再次检查。废纸篓清空后无法恢复。"
          }
        }
      }
    },
    "recoveryCheck.available": {
