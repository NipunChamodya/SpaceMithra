    "restoreWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore to the original path without overwriting existing files. If Trash has been emptied, recovery is unavailable."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "පවතින ගොනු උඩින් නොලියා මුල් ස්ථානයට ප්‍රතිසාධනය කරන්න. කුණු කූඩය හිස් කර ඇත්නම් ප්‍රතිසාධනය කළ නොහැක."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இருக்கும் கோப்புகளை மேலெழுதாமல் அசல் இடத்திற்கு மீட்டமைக்கவும். குப்பை காலியாக்கப்பட்டிருந்தால் மீட்பு கிடைக்காது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मौजूदा फ़ाइलों पर लिखे बिना मूल स्थान पर पुनर्स्थापित करें। ट्रैश खाली हो चुका है तो पुनर्प्राप्ति उपलब्ध नहीं है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الاستعادة إلى المسار الأصلي دون الكتابة فوق ملفات موجودة. لا يمكن الاستعادة بعد إفراغ السلة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restaurer à l’emplacement d’origine sans écraser de fichier. Si la Corbeille a été vidée, la récupération est impossible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "恢复到原始路径，不覆盖现有文件。如果废纸篓已被清空，则无法恢复。"
          }
        }
      }
    },
    "duplicateGuidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact SHA-256 duplicates. Choose copies individually and keep at least one. Hard links and cloud files are excluded. Shared APFS blocks cannot be identified."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SHA-256 සමාන අනුපිටපත්. පිටපත් වෙන වෙනම තෝරා අවම වශයෙන් එකක් තබාගන්න. දෘඪ සබැඳි සහ වලාකුළු ගොනු බැහැර කරයි. APFS හවුල් කොටස් හඳුනාගත නොහැක."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SHA-256 மூலம் துல்லியமான நகல்கள். தனித்தனியாகத் தேர்ந்தெடுத்து குறைந்தது ஒரு நகலை வைத்திருங்கள். கடின இணைப்புகள் மற்றும் மேகக் கோப்புகள் விலக்கப்படும். APFS பகிரப்பட்ட தொகுதிகளை அடையாளம் காண முடியாது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सटीक SHA-256 डुप्लिकेट। प्रतियाँ अलग-अलग चुनें और कम से कम एक रखें। हार्ड लिंक और क्लाउड फ़ाइलें शामिल नहीं हैं। APFS साझा ब्लॉक पहचाने नहीं जा सकते।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نسخ مطابقة باستخدام SHA-256. اختر النسخ فردياً واحتفظ بواحدة على الأقل. تُستبعد الروابط الصلبة والملفات السحابية. لا يمكن تحديد كتل APFS المشتركة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doublons exacts par SHA-256. Choisissez chaque copie et conservez-en au moins une. Les liens physiques et fichiers cloud sont exclus. Les blocs APFS partagés ne sont pas identifiables."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通过 SHA-256 检测完全相同的文件。请逐个选择副本并至少保留一个。硬链接和云端文件不参与比较。无法识别 APFS 共享块。"
          }
        }
      }
    },
