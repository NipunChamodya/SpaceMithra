        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "සංකේත සබැඳි නොමැති සැබෑ ෆෝල්ඩරයක් තෝරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "குறியீட்டு இணைப்புகள் இல்லாத உண்மையான கோப்புறையைத் தேர்ந்தெடுக்கவும்."
          }
