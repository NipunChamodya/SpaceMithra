    "trashWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only explicitly reviewed files will be moved to Trash. Moving to Trash does not free disk space. SpaceMithra never empties Trash. Close affected apps first. Recovery is possible only while the item remains available in Trash."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "තෝරා සමාලෝචනය කළ ගොනු පමණක් කුණු කූඩයට ගෙන යයි. මෙයින් තැටියේ ඉඩ නිදහස් නොවේ. යෙදුම කුණු කූඩය හිස් නොකරයි. අදාළ යෙදුම් වසන්න. ගොනුව කුණු කූඩයේ තිබෙන තුරු පමණක් ප්‍රතිසාධනය කළ හැක."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் தேர்ந்தெடுத்து சரிபார்த்த கோப்புகள் மட்டுமே குப்பைக்கு நகர்த்தப்படும். இதனால் வட்டு இடம் காலியாகாது. இந்தச் செயலி குப்பையை காலி செய்யாது. தொடர்புடைய செயலிகளை மூடவும். கோப்பு குப்பையில் இருக்கும் வரை மட்டுமே மீட்டெடுக்க முடியும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "केवल चुनी और जाँची गई फ़ाइलें ट्रैश में भेजी जाएँगी। इससे डिस्क स्थान खाली नहीं होता। यह ऐप ट्रैश खाली नहीं करता। संबंधित ऐप बंद करें। फ़ाइल ट्रैश में उपलब्ध रहने तक ही पुनर्प्राप्ति संभव है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ستُنقل إلى سلة المهملات الملفات التي اخترتها وراجعتها فقط. النقل لا يحرر مساحة القرص. لن يفرغ التطبيق السلة. أغلق التطبيقات المعنية أولاً. الاستعادة ممكنة فقط ما دام الملف متاحاً في السلة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seuls les fichiers choisis et vérifiés seront déplacés vers la Corbeille. Cela ne libère pas d’espace disque. Cette app ne vide jamais la Corbeille. Fermez les apps concernées. La récupération reste possible uniquement si le fichier est encore dans la Corbeille."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅将您明确选择并检查的文件移到废纸篓。这不会释放磁盘空间。本应用绝不会清空废纸篓。请先关闭相关应用。只有文件仍在废纸篓中时才能恢复。"
          }
        }
      }
    },
    "reviewTrash": {
