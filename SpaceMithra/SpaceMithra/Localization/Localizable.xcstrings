    "translationNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translations are drafts and require fluent-speaker review. Some text uses English fallback."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "පරිවර්තන කෙටුම්පත් වන අතර චතුර කථිකයන්ගේ සමාලෝචනය අවශ්‍යයි."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மொழிபெயர்ப்புகள் வரைவுகள்; சரளமாகப் பேசுவோர் மதிப்பாய்வு செய்ய வேண்டும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अनुवाद प्रारूप हैं; धाराप्रवाह वक्ताओं की समीक्षा आवश्यक है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الترجمات مسودات وتحتاج إلى مراجعة متحدثين متمكنين."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les traductions sont provisoires et doivent être relues par des locuteurs compétents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "翻译为草稿，需要流利使用该语言的人员审核。"
          }
        }
      }
    },
    "limitations": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder cleanup, tool commands, live-use detection, and automatic system cleanup are intentionally unavailable. Unknown data is never selected automatically."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ෆෝල්ඩර පිරිසිදු කිරීම, මෙවලම් විධාන, සජීවී භාවිත හඳුනාගැනීම සහ ස්වයංක්‍රීය පද්ධති පිරිසිදු කිරීම නොමැත. නොදන්නා දත්ත ස්වයංක්‍රීයව තෝරන්නේ නැත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கோப்புறை சுத்தப்படுத்தல், கருவிக் கட்டளைகள், நேரடி பயன்பாடு கண்டறிதல் மற்றும் தானியங்கு அமைப்புச் சுத்தப்படுத்தல் இல்லை. தெரியாத தரவு தானாகத் தேர்ந்தெடுக்கப்படாது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोल्डर सफ़ाई, टूल कमांड, सक्रिय उपयोग का पता लगाना और स्वचालित सिस्टम सफ़ाई उपलब्ध नहीं हैं। अज्ञात डेटा कभी अपने आप नहीं चुना जाता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنظيف المجلدات وأوامر الأدوات وكشف الاستخدام المباشر وتنظيف النظام تلقائياً غير متاحة. لا تُحدد البيانات غير المعروفة تلقائياً."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le nettoyage des dossiers, les commandes d’outils, la détection d’utilisation active et le nettoyage automatique du système sont indisponibles. Les données inconnues ne sont jamais sélectionnées automatiquement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暂不提供文件夹清理、工具命令、实时使用检测和自动系统清理。绝不会自动选择未知数据。"
          }
        }
      }
    },
