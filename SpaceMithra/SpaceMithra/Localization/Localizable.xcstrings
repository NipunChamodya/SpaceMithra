    "error.protected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item is protected or unsupported and was left untouched."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මෙය ආරක්ෂිත හෝ සහාය නොදක්වන අයිතමයකි. එය වෙනස් කර නැත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்த உருப்படி பாதுகாக்கப்பட்டது அல்லது ஆதரிக்கப்படவில்லை. மாற்றப்படவில்லை."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह आइटम सुरक्षित या असमर्थित है और बदला नहीं गया।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذا العنصر محمي أو غير مدعوم ولم يتم تغييره."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Élément protégé ou non pris en charge, laissé intact."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此项目受保护或不受支持，未对其进行更改。"
          }
        }
      }
    },
    "error.symlink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The path contains a symbolic link. The item was skipped."
