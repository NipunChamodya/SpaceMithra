    "disk.otherEstimate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other, protected or unmeasured (estimate)"
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "වෙනත්, ආරක්ෂිත හෝ නොමැනූ ඉඩ (ඇස්තමේන්තුව)"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "பிற, பாதுகாக்கப்பட்ட அல்லது அளவிடாத இடம் (மதிப்பீடு)"
          }
        },
        "hi": {
