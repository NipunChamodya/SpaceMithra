    "error.changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file changed since inspection. It was skipped; scan and review it again."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "පරීක්ෂාවෙන් පසු ගොනුව වෙනස් වී ඇත. මඟහැරියා; නැවත පරිලෝකනය කර සමාලෝචනය කරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "சரிபார்த்த பின் கோப்பு மாறிவிட்டது. தவிர்க்கப்பட்டது; மீண்டும் வருடிச் சரிபார்க்கவும்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जाँच के बाद फ़ाइल बदल गई। उसे छोड़ दिया गया; फिर स्कैन और समीक्षा करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تغير الملف بعد فحصه. تم تخطيه؛ أعد الفحص والمراجعة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fichier modifié depuis l’inspection. Ignoré ; analysez-le et vérifiez-le à nouveau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "文件在检查后已更改。已跳过；请重新扫描并检查。"
          }
        }
      }
    },
    "error.permission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder is not writable. Nothing was moved."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ෆෝල්ඩරයට ලිවිය නොහැක. කිසිවක් ගෙන ගියේ නැත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கோப்புறையில் எழுத முடியவில்லை. எதுவும் நகர்த்தப்படவில்லை."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोल्डर लिखने योग्य नहीं है। कुछ नहीं हटाया गया।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المجلد غير قابل للكتابة. لم يُنقل شيء."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dossier non modifiable. Aucun déplacement effectué."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
