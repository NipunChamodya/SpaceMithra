          }
        }
      }
    },
    "consequence.cache": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the owning app. Deletion may slow initial loads or require previews, builds, or downloads to be regenerated."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "හිමිකරු යෙදුම වසන්න. මකා දැමීමෙන් මුල් පැටවීම මන්දගාමී විය හැකි අතර පෙරදසුන්, ගොඩනැගීම් හෝ බාගැනීම් නැවත අවශ්‍ය විය හැක."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "தொடர்புடைய செயலியை மூடவும். நீக்கினால் ஏற்றுதல் மெதுவாகலாம்; முன்னோட்டங்கள், கட்டமைப்புகள் அல்லது பதிவிறக்கங்களை மீண்டும் உருவாக்க வேண்டியிருக்கலாம்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "संबंधित ऐप बंद करें। हटाने से आरंभिक लोड धीमा हो सकता है या पूर्वावलोकन, बिल्ड या डाउनलोड दोबारा बनाने पड़ सकते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أغلق التطبيق المالك. قد يبطئ الحذف التحميل الأولي أو يتطلب إعادة إنشاء معاينات أو عمليات بناء أو تنزيلات."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fermez l’application concernée. La suppression peut ralentir les premiers chargements ou nécessiter de régénérer aperçus, compilations ou téléchargements."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请关闭所属应用。删除可能导致首次加载变慢，或需要重新生成预览、构建结果或下载内容。"
          }
        }
      }
    },
