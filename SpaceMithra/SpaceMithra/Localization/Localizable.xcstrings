    "confirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move these exact files to Trash?"
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මෙම නිශ්චිත ගොනු කුණු කූඩයට ගෙන යන්නද?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இந்தக் குறிப்பிட்ட கோப்புகளைக் குப்பைக்கு நகர்த்தவா?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इन सटीक फ़ाइलों को ट्रैश में भेजें?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نقل هذه الملفات بعينها إلى سلة المهملات؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déplacer ces fichiers précis vers la Corbeille ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将这些确切的文件移到废纸篓？"
          }
        }
      }
    },
    "reviewConsequences": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review every path and consequence. Changed, protected, or inaccessible items will be skipped. Unknown files may contain important personal data."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "සෑම මාර්ගයක් සහ ප්‍රතිවිපාකයක්ම සමාලෝචනය කරන්න. වෙනස් වූ, ආරක්ෂිත හෝ ප්‍රවේශ නොහැකි අයිතම මඟහරියි. නොදන්නා ගොනුවල වැදගත් දත්ත තිබිය හැක."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஒவ்வொரு பாதையையும் விளைவையும் சரிபார்க்கவும். மாற்றப்பட்ட, பாதுகாக்கப்பட்ட அல்லது அணுக முடியாத உருப்படிகள் தவிர்க்கப்படும். தெரியாத கோப்புகளில் முக்கியமான தரவு இருக்கலாம்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हर पथ और परिणाम जाँचें। बदले हुए, सुरक्षित या अप्राप्य आइटम छोड़ दिए जाएँगे। अज्ञात फ़ाइलों में महत्वपूर्ण डेटा हो सकता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "راجع كل مسار ونتائجه. ستُتخطى العناصر المتغيرة أو المحمية أو غير المتاحة. قد تحتوي الملفات غير المعروفة على بيانات مهمة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiez chaque chemin et les conséquences. Les éléments modifiés, protégés ou inaccessibles seront ignorés. Les fichiers inconnus peuvent contenir des données importantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
