    "dev.cacheConsequence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May be created again by the tool. Close builds first; removal may require downloads or slower rebuilds."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මෙවලම නැවත සෑදිය හැක. පළමුව ගොඩනැගීම් වසන්න; නැවත බාගැනීම් අවශ්‍ය විය හැක."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கருவி மீண்டும் உருவாக்கலாம். கட்டமைப்புகளை நிறுத்தவும்; பதிவிறக்கங்கள் மீண்டும் தேவைப்படலாம்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "टूल इसे फिर बना सकता है। पहले बिल्ड बंद करें; दोबारा डाउनलोड या धीमा बिल्ड हो सकता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قد يعيدها البرنامج. أوقف عمليات البناء أولاً؛ قد تلزم تنزيلات أو إعادة بناء أبطأ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’outil peut les recréer. Fermez les compilations ; téléchargements ou recompilations plus lentes possibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工具可能会重新生成这些文件。请先停止构建；删除后可能需要重新下载或更慢的重建。"
          }
        }
      }
    },
    "dev.keepState": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep unless you understand its dependencies. This may contain active environments, installed tools or unique project data."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "පරායත්තතා දන්නා තුරු තබාගන්න. සක්‍රිය පරිසර හෝ අනන්‍ය ව්‍යාපෘති දත්ත තිබිය හැක."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "சார்புகளை அறியாவிட்டால் வைத்திருக்கவும். செயலில் உள்ள சூழல் அல்லது தனித்துவத் திட்டத் தரவு இருக்கலாம்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "निर्भरताएँ समझने तक रखें। इसमें सक्रिय वातावरण, इंस्टॉल टूल या अद्वितीय परियोजना डेटा हो सकता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "احتفظ به ما لم تفهم تبعياته. قد يضم بيئات نشطة أو أدوات أو بيانات مشروع فريدة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conservez-le sans connaissance de ses dépendances : environnements actifs, outils ou données uniques possibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "除非您了解其依赖关系，否则请保留。这里可能包含活动环境、已安装工具或独有项目数据。"
          }
        }
      }
    },
    "dev.mechanism": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the tool’s own maintenance options. The command shown only inspects or previews; SpaceMithra does not execute it."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මෙවලමේ නඩත්තු විකල්ප භාවිත කරන්න. පෙන්වන විධානය පරීක්ෂා කිරීමට පමණි; SpaceMithra ක්‍රියාත්මක නොකරයි."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கருவியின் பராமரிப்பை பயன்படுத்தவும். காட்டும் கட்டளை பார்வைக்கு மட்டும்; SpaceMithra இயக்காது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "टूल के रखरखाव विकल्प उपयोग करें। दिखाया आदेश केवल जाँच या पूर्वावलोकन करता है; SpaceMithra उसे चलाता नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدم صيانة الأداة نفسها. الأمر للفحص أو المعاينة فقط ولا ينفذه SpaceMithra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez la maintenance de l’outil. La commande inspecte ou prévisualise seulement ; SpaceMithra ne l’exécute pas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请使用工具自身的维护选项。显示的命令仅用于检查或预览；SpaceMithra 不会执行它。"
          }
        }
      }
    },
