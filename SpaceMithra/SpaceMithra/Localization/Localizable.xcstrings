    "apps.bundleDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App files make the application work. They are separate from caches and personal data; SpaceMithra does not uninstall apps."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "යෙදුම් ගොනු යෙදුම ක්‍රියාත්මක කරයි. ඒවා හැඹිලි සහ පෞද්ගලික දත්තවලින් වෙන් වේ; SpaceMithra යෙදුම් අස්ථාපනය නොකරයි."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "செயலிக் கோப்புகள் செயலியை இயக்குகின்றன. அவை தற்காலிகச் சேமிப்பு மற்றும் தனிப்பட்ட தரவிலிருந்து வேறு; SpaceMithra செயலிகளை அகற்றாது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऐप फ़ाइलें ऐप चलाती हैं। ये कैश और निजी डेटा से अलग हैं; SpaceMithra ऐप अनइंस्टॉल नहीं करता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تشغّل هذه الملفات التطبيق وهي منفصلة عن التخزين المؤقت والبيانات الشخصية؛ لا يزيل SpaceMithra التطبيقات."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces fichiers font fonctionner l’app. Ils sont distincts des caches et données personnelles ; SpaceMithra ne désinstalle pas les apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "应用文件用于运行应用，与缓存和个人数据分开统计；SpaceMithra 不会卸载应用。"
          }
        }
      }
    },
