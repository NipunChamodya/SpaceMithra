    "dev.cachePurpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary tool downloads and generated resources, identified by their known storage location."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "හඳුනාගත් ස්ථානයක ඇති තාවකාලික මෙවලම් බාගැනීම් සහ නිපදවූ සම්පත්."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அறியப்பட்ட இடத்தில் உள்ள தற்காலிக பதிவிறக்கங்கள் மற்றும் உருவாக்கப்பட்ட வளங்கள்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ज्ञात स्थान में अस्थायी टूल डाउनलोड और बनाए गए संसाधन।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنزيلات مؤقتة وموارد مولدة معروفة بموقع تخزينها."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Téléchargements temporaires et ressources générées identifiés par leur emplacement connu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "根据已知存储位置识别的工具临时下载和生成资源。"
          }
        }
      }
    },
    "dev.statePurpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files used by development tools or projects. Some may be unique or required to run your work."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "සංවර්ධන මෙවලම් හෝ ව්‍යාපෘති භාවිත කරන ගොනු. සමහරක් අනන්‍ය හෝ ඔබේ කාර්යයට අත්‍යවශ්‍ය විය හැක."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மேம்பாட்டுக் கருவிகள் அல்லது திட்டங்கள் பயன்படுத்தும் கோப்புகள். சில தனித்துவமானவை அல்லது அவசியமானவை."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "डेवलपमेंट टूल या परियोजनाओं द्वारा उपयोग की गई फ़ाइलें। कुछ अद्वितीय या काम के लिए आवश्यक हो सकती हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ملفات تستخدمها أدوات التطوير أو المشاريع. قد يكون بعضها فريداً أو ضرورياً لعملك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fichiers utilisés par les outils ou projets. Certains peuvent être uniques ou indispensables."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "开发工具或项目使用的文件。其中部分可能是独有内容或工作运行所必需的。"
          }
        }
      }
    },
