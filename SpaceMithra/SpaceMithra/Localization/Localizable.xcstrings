    "dashboard.logicalNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards describe accessible scanned files. Downloads is its own group; these file-size estimates do not add up to physical disk usage."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "කාඩ්පත් ප්‍රවේශ කළ හැකි පරිලෝකිත ගොනු විස්තර කරයි. බාගැනීම් වෙනම කාණ්ඩයකි; මෙම ප්‍රමාණ භෞතික තැටි භාවිතයට සමාන නොවේ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "அட்டைகள் அணுகக்கூடிய வருடிய கோப்புகளைக் காட்டுகின்றன. பதிவிறக்கங்கள் தனிக் குழு; இந்த அளவுகள் இயற்பியல் வட்டுப் பயன்பாட்டுடன் பொருந்தாது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कार्ड सुलभ स्कैन की गई फ़ाइलें दिखाते हैं। डाउनलोड अलग समूह है; ये आकार भौतिक डिस्क उपयोग के बराबर नहीं हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تصف البطاقات الملفات المتاحة المفحوصة. التنزيلات مجموعة مستقلة؛ لا تساوي هذه الأحجام الاستخدام الفعلي للقرص."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les cartes décrivent les fichiers accessibles analysés. Les téléchargements sont séparés ; ces tailles ne s’additionnent pas à l’usage physique du disque."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "卡片描述可访问的已扫描文件。“下载”单独分组；这些文件大小估计值不会与物理磁盘占用完全一致。"
          }
        }
      }
    },
    "dashboard.duplicates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for identical files, then choose which copies to keep. Nothing is selected for you."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "සමාන ගොනු සොයා තබාගන්නා පිටපත් තෝරන්න. කිසිවක් ඔබ වෙනුවෙන් තෝරන්නේ නැත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ஒரே மாதிரியான கோப்புகளைக் கண்டறிந்து எந்த நகலை வைத்திருக்க வேண்டும் என்று தேர்ந்தெடுக்கவும். தானியங்கித் தேர்வு இல்லை."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "समान फ़ाइलें खोजकर तय करें कि कौन सी प्रतियाँ रखनी हैं। कोई चयन अपने आप नहीं होता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابحث عن ملفات متطابقة ثم اختر النسخ التي تحتفظ بها. لا نحدد شيئاً نيابة عنك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cherchez les fichiers identiques, puis choisissez les copies à conserver. Aucune présélection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "查找完全相同的文件，然后选择保留哪些副本。不会替您自动选择。"
          }
        }
      }
    },
