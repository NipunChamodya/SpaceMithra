    "disk.shared": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac uses connected storage areas. This overview counts startup storage once."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ඔබේ Mac සම්බන්ධිත ගබඩා ප්‍රදේශ භාවිත කරයි. මෙම දළ විශ්ලේෂණය ආරම්භක ගබඩාව එක් වරක් ගණනය කරයි."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் Mac இணைக்கப்பட்ட சேமிப்பகங்களைப் பயன்படுத்துகிறது. தொடக்கச் சேமிப்பகம் ஒரு முறை மட்டுமே கணக்கிடப்படுகிறது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका Mac जुड़े हुए स्टोरेज क्षेत्रों का उपयोग करता है। यहाँ स्टार्टअप स्टोरेज एक बार गिना जाता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يستخدم Mac مساحات تخزين مترابطة. تُحسب مساحة بدء التشغيل مرة واحدة هنا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre Mac utilise des espaces de stockage reliés. Le stockage de démarrage est compté une seule fois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac 使用多个相连的存储区域。此概览只计算一次启动存储空间。"
          }
        }
      }
    },
    "disk.capacitySource": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacity comes from macOS, independently of scanned files. Values use decimal GB and are rounded. Important-use availability can include space macOS may release; it is not added to free space."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ධාරිතාව පරිලෝකනයෙන් ස්වාධීනව macOS වෙතින් ලැබේ. අගයන් දශම GB වලින් වට කර ඇත. වැදගත් භාවිතයට ඇති ඉඩ නිදහස් ඉඩට එකතු නොකරයි."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கொள்ளளவு வருடலிலிருந்து தனியாக macOS மூலம் பெறப்படுகிறது. தசம GB இல் வட்டமிடப்படுகிறது. முக்கிய பயன்பாட்டுக்கான இடம் காலி இடத்துடன் சேர்க்கப்படாது."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "क्षमता macOS से मिलती है, स्कैन से अलग। दशमलव GB में मान गोल हैं। महत्वपूर्ण उपयोग की उपलब्धता खाली स्थान में नहीं जोड़ी जाती।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تأتي السعة من macOS مستقلة عن الفحص. القيم مقربة بوحدة GB العشرية. لا تُضاف إتاحة الاستخدام المهم إلى المساحة الحرة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Capacité fournie par macOS indépendamment de l’analyse, arrondie en Go décimaux. La disponibilité pour usage important ne s’ajoute pas à l’espace libre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "容量由 macOS 报告，与扫描文件独立。数值使用十进制 GB 并经过舍入。重要用途可用空间不会与空闲空间相加。"
          }
        }
      }
    },
