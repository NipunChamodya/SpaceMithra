          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نتعرّف على مساحة تخزينك"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Découverte de votre stockage"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在了解您的存储空间"
          }
        }
      }
    },
    "scan.finding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding folders and reading file sizes…"
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ෆෝල්ඩර සොයා ගොනු ප්‍රමාණ කියවමින්…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "கோப்புறைகளைக் கண்டறிந்து கோப்பு அளவுகளைப் படிக்கிறது…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोल्डर खोजकर फ़ाइलों के आकार पढ़े जा रहे हैं…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "العثور على المجلدات وقراءة أحجام الملفات…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Recherche des dossiers et lecture des tailles…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在查找文件夹并读取文件大小…"
          }
        }
      }
    },
    "scan.indeterminate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We don’t know the total number of files yet, so we show real counts instead of a guessed percentage."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මුළු ගොනු ගණන තවම නොදන්නා නිසා අනුමාන ප්‍රතිශතයක් වෙනුවට සැබෑ ගණන් පෙන්වමු."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "மொத்தக் கோப்புகளின் எண்ணிக்கை இன்னும் தெரியாததால் ஊகித்த சதவீதத்திற்குப் பதில் உண்மையான எண்ணிக்கையைக் காட்டுகிறோம்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कुल फ़ाइलों की संख्या अभी ज्ञात नहीं है, इसलिए अनुमानित प्रतिशत की जगह वास्तविक गिनती दिखती है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عدد الملفات الإجمالي غير معروف بعد، لذا نعرض أعداداً فعلية بدلاً من نسبة تقديرية."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le nombre total de fichiers est encore inconnu : nous affichons les comptes réels plutôt qu’un pourcentage supposé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚不知道文件总数，因此显示实际数量，而不是猜测的百分比。"
          }
        }
      }
    },
