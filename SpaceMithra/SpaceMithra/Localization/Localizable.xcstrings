    "apps.noUninstall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are protected application files. Do not uninstall an app by removing arbitrary support folders."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "මේවා ආරක්ෂිත යෙදුම් ගොනුය. අහඹු සහාය ෆෝල්ඩර ඉවත් කර යෙදුම් අස්ථාපනය නොකරන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இவை பாதுகாக்கப்பட்ட செயலிக் கோப்புகள். ஆதரவுக் கோப்புறைகளை அகற்றி செயலியை நீக்க வேண்டாம்."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ये सुरक्षित ऐप फ़ाइलें हैं। मनमाने सहायक फ़ोल्डर हटाकर ऐप अनइंस्टॉल न करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذه ملفات تطبيق محمية. لا تزل التطبيقات بحذف مجلدات دعم عشوائية."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fichiers d’application protégés. Ne désinstallez pas une app en supprimant arbitrairement ses dossiers de support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这些是受保护的应用文件。请勿通过删除任意支持文件夹来卸载应用。"
          }
        }
      }
    },
